<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_ingredient_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textViewIngredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredient"
        android:textColor="@color/pantry_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewIngredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Quantity"
        android:textColor="@color/pantry_green"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewIngredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Expiry Date"
        android:textColor="@color/pantry_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditIngredient"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/pantry_green_light"
            android:text="@string/edit"
            android:textAllCaps="false"
            android:textColor="@color/pantry_green_dark" />

        <Button
            android:id="@+id/btnDeleteIngredient"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@android:color/holo_red_light"
            android:text="@string/delete"
            android:textAllCaps="false"
            android:textColor="@color/pantry_white" />

    </LinearLayout>

</LinearLayout>