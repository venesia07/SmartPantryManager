<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pantry_cream"
    android:orientation="vertical">

    <!-- HEADER -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pantry_green"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/smart_pantry"
            android:textColor="@color/pantry_white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/pantry_subtitle"
            android:textColor="@color/pantry_green_light"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- YOUR PANTRY + REFRESH -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_pantry"
                android:textColor="@color/pantry_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/pantry_section_description"
                android:textColor="@color/pantry_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnRefreshPantry"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/pantry_green_light"
            android:text="@string/refresh_pantry"
            android:textAllCaps="false"
            android:textColor="@color/pantry_green_dark"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- INGREDIENT LIST -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <!-- ADD INGREDIENT -->

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/pantry_green"
        android:text="@string/add_ingredient"
        android:textAllCaps="false"
        android:textColor="@color/pantry_white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>